# Copy to .env (docker compose reads it automatically). All settings are optional.
# Hostnames accepted in the Host header (DNS-rebinding protection). Local default: localhost,127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1
# Opt-in unofficial sources (off by default). These are third-party sites with their own terms of use;
# enabling them is your decision and responsibility. NTES terms forbid building a database or commercial use.
#   confirmtkt,erail          timetables, seats, fares
#   etrain,ntes,railradar     delay history
ENABLE_UNOFFICIAL_SOURCES=
# Client settings the unofficial sources require (not included in this repository):
#   confirmtkt: the client identification headers its web app sends
CONFIRMTKT_CLIENT_ID=
CONFIRMTKT_API_KEY=
#   erail: the route-page parameter its web app sends
ERAIL_ROUTE_KEY=
# Geocoding for find_nearby_stations: nominatim (default) | off
GEOCODER=nominatim
# Contact email sent to Nominatim per its usage policy (recommended)
NOMINATIM_EMAIL=
# Identifying User-Agent for outbound requests (recommended: include a contact URL)
HTTP_USER_AGENT=
# Time budget (ms) per tool call for cross-checking facts against other sources (default 20000)
VERIFY_BUDGET_MS=20000
